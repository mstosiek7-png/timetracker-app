# =====================================================
# TimeTracker - Zmienne środowiskowe
# =====================================================
# Skopiuj ten plik jako .env.local i uzupełnij wartości

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LiteLLM Proxy Configuration (wymagane dla funkcji AI: OCR, raporty)
EXPO_PUBLIC_LITELLM_PROXY_URL=https://your-litellm-proxy.example.com
EXPO_PUBLIC_LITELLM_KEY=your-litellm-api-key

# App Configuration
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENV=development
